{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stepwise",
  "compatibility_date": "2026-10-01",
  // Pure static site: every algorithm runs in the browser. `npm run build` writes dist/.
  "assets": { "directory": "./dist", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "routes": [{ "pattern": "stepwise.jashparmar.com", "custom_domain": true }],
  "workers_dev": false
}
